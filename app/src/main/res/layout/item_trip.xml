<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/dashboard_card_bg"
    android:padding="14dp"
    android:orientation="vertical">

    <!-- DATE HEADER LAYOUT (shown for header items) -->
    <LinearLayout
        android:id="@+id/dateHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- Top divider - shows only if not first item -->
        <View
            android:id="@+id/headerDividerTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="12dp"/>

        <!-- Header Title -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:text="TODAY'S TRIPS - Wednesday, February 12, 2025"/>

        <!-- Bottom divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

    <!-- Main Card -->
    <LinearLayout
        android:id="@+id/mainCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="5dp">

        <!-- Trip ID and Flight No -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/tvQueueBadge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_blue_background"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTripType"
                android:text="Trip Type: "
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#172747"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:textAlignment="center"/>
        </LinearLayout>

        <!-- Trip ID and Flight No -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/tvTripId"
                android:text="Trip ID"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#172747"
                android:layout_width="0dp"
                android:layout_weight="3"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvFlightNo"
                android:text="Flight No."
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#172747"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvCompany"
                android:text="Company"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#172747"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Client Name and Contact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvClientName"
                android:text="Client Name: "
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#172747"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvContactNumber"
                android:text="Contact No.: "
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#172747"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Pickup & Dropoff -->
        <TextView
            android:id="@+id/tvPickup"
            android:text="Pickup"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvDropoff"
            android:text="Drop-off"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            android:textColor="#555555"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Date & Time -->
        <TextView
            android:id="@+id/tvDate"
            android:text="Date"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvTime"
            android:text="Time"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvPax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PAX: "
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/tvRFID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RFID Balance:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:layout_marginTop="10dp"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvRFIDlastUpdated"
            android:text="RFID Last updated:"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:text="Status"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- HIDDEN LAYOUT: Wrap all elements that should be toggled -->
    <LinearLayout
        android:id="@+id/hiddenLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="10dp">

        <!-- ETA Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/ETA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estimated Time of Arrival: "
                android:textColor="@android:color/black"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/ETAUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last updated: "
                android:textColor="@android:color/black"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="The estimated time of arrival might be off by 5 to 10 minutes. This information is calculated manually based on Aviation Edge Fetch API. For additional and more accurate information, visit FlightAware by clicking the button below."
                android:textColor="@android:color/black"
                android:textAlignment="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="10dp">
            <!-- FlightAware Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFlightAware"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_card"
                android:textColor="@android:color/black"
                android:text="Flight Number"/>

            <!-- Back to Active Trip -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/backToActiveTrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Maps"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:textColor="@android:color/black"
                android:textSize="18sp"/>

        </LinearLayout>

        <!-- Slide to Confirm -->
        <SeekBar
            android:id="@+id/slideConfirm"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="3"
            android:thumb="@drawable/slider_thumb"
            android:progressDrawable="@drawable/slider_track"
            android:splitTrack="false"/>

        <!-- Copy Client & Contact -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/copyClientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy Client Name"
                android:background="@drawable/bg_card"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:layout_marginEnd="10dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/copyContactNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy Contact Number"
                android:background="@drawable/bg_card"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

        <!-- Horizontal Scroll Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/sendItenary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send Itinerary"
                    android:background="@drawable/bg_card"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/arrivedPickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Driver Arrived at Pickup Point"
                    android:background="@drawable/bg_card"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/driverUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request Client Update"
                    android:background="@drawable/bg_card"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/reviewAndRatings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Review and Ratings"
                    android:background="@drawable/bg_card"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/overtimeMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Overtime"
                    android:background="@drawable/bg_card"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Set Alarm -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSetAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Set Alarm for Trip"
            android:background="@drawable/bg_card"
            android:textColor="@android:color/black"
            android:textSize="18sp"/>

        <!-- No Show Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClientNoShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Client No Show"
            android:background="@drawable/bg_card"
            android:textColor="@android:color/black"
            android:textSize="18sp"/>

        <LinearLayout
            android:id="@+id/statusContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"/>

    </LinearLayout>
</LinearLayout>